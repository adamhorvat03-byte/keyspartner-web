# ==============================================================================
# Konfigurácia prostredia pre Realsoft / Admin Nehnuteľnosti Webhook
# KEYS & PARTNERS a.s. - Produkčná doména: https://keyspartner.netlify.app
# ==============================================================================
# Skopírujte tento súbor ako '.env' vo vašom projekte:
# cp .env.example .env
# ==============================================================================

# 1. Produkčná URL adresa webu na Netlify
NEXT_PUBLIC_SITE_URL=https://keyspartner.netlify.app

# 2. Autentifikácia pre Admin Nehnuteľnosti / Realsoft (United Classifieds)
# URL pre nastavenie webhooku v Realsofte:
# https://keyspartner.netlify.app/api/realsoft-webhook
#
# API Kľúč overovaný z:
#   - HTTP hlavičky: 'x-api-key: ...' alebo 'Authorization: Bearer ...'
#   - Tela požiadavky: pole 'apiKey' alebo 'api_key'
REALSOFT_API_KEY=vygenerovany_tajny_retazec_keyspartners_2026

# Spätná kompatibilita (voliteľné)
REALSOFT_SECRET_KEY=vygenerovany_tajny_retazec_keyspartners_2026

# 3. Voliteľná HTTP Basic Auth (ak Admin Nehnuteľnosti posiela Meno a Heslo)
REALSOFT_USER=admin_nehnutelnosti
REALSOFT_PASS=tajne_heslo_partnera_987

# 4. Pripojenie k databáze (Prisma / PostgreSQL / MySQL)
DATABASE_URL="postgresql://postgres:heslo@localhost:5432/keyspartners_db?schema=public"

# 5. Voliteľné systémové nastavenia
NODE_ENV=production
PORT=3000
